# Growth Blueprint Advisory — environment template. Copy to .env.local (git-ignored).
# No values are required to run the site: without Sanity settings it uses local sample content.
# All accounts below must be created and owned by Growth Blueprint Advisory.

# Public site origin (used for canonical and alternate-language URLs). Default: http://localhost:3000
SITE_URL=

# Sanity (public-site content ONLY — never enquiry, scorecard or customer data)
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_VERSION=2025-01-01

# Insights: draft-preview articles are hidden in production unless their status is "published" in the content data.
# Set to 1 ONLY to preview layout-test drafts in a production build. Never set on the live site.
SHOW_DRAFT_PREVIEWS=

# Readiness scorecard: development-only demo fixture (clearly labelled sample questions/results for layout testing).
# Works ONLY with `npm run dev`. Ignored in production builds, where the demo code is not even bundled.
SCORECARD_DEMO=

# Consultation booking: development-only demo fixture (fake packages, prices, availability and a simulated hosted checkout).
# Works ONLY with `npm run dev`. Ignored in production builds, where the demo code is not even bundled.
BOOKING_DEMO=
# No calendar or payment credentials exist yet. When the client creates their own accounts, add server-side secrets here
# (never NEXT_PUBLIC_*) and install the provider adapters in src/booking/providers.ts.

# Sector-brief shop: development-only demo fixture (preview products, fake prices, a simulated hosted checkout and a
# placeholder download). Works ONLY with `npm run dev`. Ignored in production builds, where the demo code is not bundled.
SHOP_DEMO=
# No payment, private-storage or order-store accounts exist yet. When the client creates their own, add server-side secrets
# here (never NEXT_PUBLIC_*) and install the adapters in src/shop/providers.ts. Paid files must stay in PRIVATE storage.

# Enquiry form and newsletter: development-only demo fixture (a CLIENT-SIDE layout preview that sends, stores and logs nothing).
# Works ONLY with `npm run dev`. Ignored in production builds, where the demo code is not bundled.
CONTACT_DEMO=
# No CRM, email or newsletter provider has been selected, and no credentials exist. Real submissions stay DISABLED until the
# client selects providers, supplies approved consent wording and legal text, and an adapter is installed in
# src/contact/providers.ts. Adapters read their secrets from SERVER-SIDE variables only (never NEXT_PUBLIC_*). Names below
# are generic placeholders to be replaced by the chosen provider's real requirements; leave empty until then.
# CRM_API_BASE_URL=
# CRM_API_KEY=
# NEWSLETTER_API_BASE_URL=
# NEWSLETTER_API_KEY=
# NEWSLETTER_LIST_ID=

# ---- Search visibility (technical SEO) ---------------------------------------------------------------------------------
# DEFAULT = NOT INDEXABLE. Staging, previews and local builds send noindex meta + X-Robots-Tag, robots.txt "Disallow: /" and
# an empty sitemap. Set BOTH of these ONLY on the live production build (they are read at BUILD time):
#   SITE_URL=https://<the real production domain>   (must be https and public)
#   ALLOW_INDEXING=1
# Never set ALLOW_INDEXING on staging or preview. Hosting preview flags (VERCEL_ENV != production, Netlify CONTEXT != production)
# also force noindex. Do not launch indexing until the Arabic text is professionally reviewed and content is approved.
ALLOW_INDEXING=

# ---- Analytics ---------------------------------------------------------------------------------------------------------
# No analytics provider or consent requirement is confirmed, so there are NO analytics variables yet and nothing is loaded.
# See docs/analytics-handover.md. When the client selects a provider, add its (client-owned) ids here, not in code.
