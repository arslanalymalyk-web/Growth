# Copy to .env and export before `node server.mjs` (the server reads the process environment; it does not load .env itself).
PORT=3000
PUBLIC_BASE_URL=https://www.example.com
TRUST_PROXY=1
DOWNLOAD_SIGNING_SECRET=            # long random string
DEMO_PAYMENTS=0                     # 1 = simulated payments
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
MAIL_PROVIDER=resend                # resend | webhook
RESEND_API_KEY=
MAIL_FROM="Growth Blueprint <hello@example.com>"
TURNSTILE_SECRET_KEY=
ADMIN_TOKEN=                        # long random string; enables /admin
SELLER_NAME="Growth Blueprint"
SELLER_VAT_NO=
SELLER_CR_NO=
# Build-time (node build.mjs):
SITE_URL=https://www.example.com
TURNSTILE_SITE_KEY=
ANALYTICS_DOMAIN=www.example.com
# Advisory sessions (placeholders: confirm the prices)
SESSION_PRICE_SINGLE=1500
SESSION_PRICE_BUNDLE=3900
SESSION_BLACKOUT_DATES=            # comma-separated YYYY-MM-DD (holidays, leave)
MEETING_URL=                       # standing video-call link printed in emails and the calendar file (optional)
PAYMENT_PROVIDER=moyasar           # hosted card payment page; leave empty for simulated payments
MOYASAR_SECRET_KEY=
PAYMENT_API_BASE=https://api.moyasar.com/v1
